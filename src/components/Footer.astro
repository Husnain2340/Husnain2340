---
import { AUTHOR } from '../consts';
import SocialLinks from './SocialLinks.astro';
---

<footer>
	<SocialLinks />
	<p>&copy; {new Date().getFullYear()} {AUTHOR}. Built with Astro.</p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: 4rem;
		padding: 2rem 1rem 3rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	p {
		margin: 0;
	}
</style>
