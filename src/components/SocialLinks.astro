---
import { SOCIALS } from '../consts';
import { withBase } from '../utils';

const links = [
	{ key: 'github', label: 'GitHub', href: SOCIALS.github },
	{ key: 'linkedin', label: 'LinkedIn', href: SOCIALS.linkedin },
	{ key: 'x', label: 'X (Twitter)', href: SOCIALS.x },
	{ key: 'email', label: 'Email', href: SOCIALS.email },
	{ key: 'rss', label: 'RSS feed', href: withBase('/rss.xml') },
].filter((l) => l.href);
---

<ul class="socials">
	{
		links.map((l) => (
			<li>
				<a
					href={l.href}
					aria-label={l.label}
					title={l.label}
					{...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						{l.key === 'github' && (
							<>
								<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
								<path d="M9 18c-4.51 2-5-2-7-2" />
							</>
						)}
						{l.key === 'linkedin' && (
							<>
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
								<rect x="2" y="9" width="4" height="12" />
								<circle cx="4" cy="4" r="2" />
							</>
						)}
						{l.key === 'x' && (
							<path
								fill="currentColor"
								stroke="none"
								d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
							/>
						)}
						{l.key === 'email' && (
							<>
								<rect x="2" y="4" width="20" height="16" rx="2" />
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
							</>
						)}
						{l.key === 'rss' && (
							<>
								<path d="M4 11a9 9 0 0 1 9 9" />
								<path d="M4 4a16 16 0 0 1 16 16" />
								<circle cx="5" cy="19" r="1" />
							</>
						)}
					</svg>
				</a>
			</li>
		))
	}
</ul>

<style>
	.socials {
		display: flex;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
		background: var(--surface);
	}
</style>
